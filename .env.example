# .env.example — Copy this file to `.env` and fill in your keys.
# The .env file is gitignored so your keys stay private.

# Get your Voyage AI key at: https://dash.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# Get your Anthropic key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
